# Local Docker Desktop setup. Copy to .env only if you do not already have one.
# Keep your existing unrelated environment settings.
# Compose supplies the local database, AWS/LocalStack and Rails environment.

# Google OAuth client with http://localhost:3000/auth/google_oauth2/callback allowed.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Credentials for the Mandrill account used for LOCAL TESTING only.
# Use an approved sender belonging to that same account.
MANDRILL_API_KEY=
MANDRILL_SMS_FROM=
MANDRILL_FROM_EMAIL=

# Enable a channel after configuring its key and sender.
SPROUT_SMS_MAILCHIMP_ENABLED=false
SPROUT_EMAIL_MAILCHIMP_ENABLED=false

# Optional Mailchimp Marketing key for audience/tag inspection scripts.
# This is a different credential; do not use it as MANDRILL_API_KEY.
MAILCHIMP_API_KEY=

# After editing: docker compose up -d --force-recreate web
# Mandrill's email Test Key simulates email; it does not prove phone/inbox receipt.
# Real SMS testing needs an SMS-enabled account, approved sender and credits.
