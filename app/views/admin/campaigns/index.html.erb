<div class="volunteer-page">
  <h1 class="page-title">Mailchimp Campaigns</h1>
  <p class="help-text">
    Recent campaigns from your Mailchimp account (Marketing API). Send campaigns from Mailchimp;
    Sprout lists them here so you can confirm drafts and recent sends.
  </p>

  <% if @mailchimp_error.present? %>
    <section class="card">
      <h2 class="section-heading">Could not load campaigns</h2>
      <p class="help-text mb-0"><%= @mailchimp_error %></p>
      <p class="subtle mt-2 mb-0">
        Ensure <code>MAILCHIMP_API_KEY</code> is set in <code>.env</code> and restart the app.
      </p>
    </section>
  <% elsif @campaigns.any? %>
    <p class="subtle mb-4">Showing <%= @campaigns.size %> of <%= @total_items %> campaigns (newest first).</p>
    <div class="grid gap-4">
      <% @campaigns.each do |campaign| %>
        <% settings = campaign["settings"] || {} %>
        <% title = settings["title"].presence || "(untitled)" %>
        <section class="card">
          <div class="flex flex-col gap-3 md:flex-row md:items-start md:justify-between">
            <div class="space-y-2">
              <h2 class="section-heading mb-0"><%= title %></h2>
              <div class="text-sm text-gray-700 flex flex-wrap gap-2">
                <span class="inline-flex items-center rounded-full border border-gray-300 px-3 py-1">
                  <strong class="mr-1">Status:</strong> <%= campaign["status"] %>
                </span>
                <span class="inline-flex items-center rounded-full border border-gray-300 px-3 py-1">
                  <strong class="mr-1">Type:</strong> <%= campaign["type"] %>
                </span>
                <% if campaign["create_time"].present? %>
                  <span class="inline-flex items-center rounded-full border border-gray-300 px-3 py-1">
                    <strong class="mr-1">Created:</strong>
                    <%= Time.zone.parse(campaign["create_time"]).strftime("%m/%d/%Y %H:%M") rescue campaign["create_time"] %>
                  </span>
                <% end %>
              </div>
              <p class="subtle mb-0">
                <strong>Subject:</strong> <%= settings["subject_line"].presence || "—" %>
              </p>
            </div>
            <div class="action-toolbar">
              <% if campaign["archive_url"].present? %>
                <%= link_to "Archive", campaign["archive_url"], class: "button-link", target: "_blank", rel: "noopener" %>
              <% end %>
            </div>
          </div>
        </section>
      <% end %>
    </div>
  <% else %>
    <section class="card">
      <h2 class="section-heading">No campaigns found</h2>
      <p class="help-text mb-0">Create a campaign in Mailchimp, then refresh this page.</p>
    </section>
  <% end %>
</div>
