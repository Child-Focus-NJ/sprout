<h2 class="section-heading">Employees</h2>

<ul id="employee-list" class="volunteer-list mb-3">
  <% @users.each do |user| %>
    <li id="user_<%= user.id %>" class="volunteer-row">
      <% if params[:edit_user_id] == user.id.to_s %>
        <%= form_with url: user_path(user), method: :patch, local: true do %>
          <div class="grid gap-3 max-w-md">
            <div class="form-row">
              <%= label_tag :first_name, "First Name", class: "font-semibold text-gray-800" %>
              <%= text_field_tag :first_name, user.first_name, class: "input-large" %>
            </div>
            <div class="form-row">
              <%= label_tag :last_name, "Last Name", class: "font-semibold text-gray-800" %>
              <%= text_field_tag :last_name, user.last_name, class: "input-large" %>
            </div>
            <div class="form-row">
              <%= label_tag :email, "Email", class: "font-semibold text-gray-800" %>
              <%= email_field_tag :email, user.email, class: "input-large" %>
            </div>
            <div class="form-row">
              <%= label_tag :role, "Role", class: "font-semibold text-gray-800" %>
              <%= select_tag :role, options_for_select(User.roles.keys.map { |r| [ r.humanize, r ] }, user.role),
                    class: "input-large" %>
            </div>
            <%= submit_tag "Save Employee", class: "button-primary mt-1" %>
            <%= link_to "Cancel", system_management_path(tab: "employees"), class: "button-link" %>
          </div>
        <% end %>
      <% else %>
        <div class="volunteer-meta">
          <span class="volunteer-name"><%= user.full_name %></span>
          <span class="help-text"><%= user.role.to_s.humanize %></span>
        </div>
        <div class="volunteer-actions">
          <% if params[:confirm_remove_user_id] == user.id.to_s %>
            <span>Are you sure you want to remove this user?</span>
            <%= button_to "Yes", user_path(user), method: :delete, class: "btn-delete" %>
            <%= link_to "Cancel", system_management_path(tab: "employees"), class: "button-link" %>
          <% else %>
            <%= link_to "Edit", system_management_path(tab: "employees", edit_user_id: user.id),
                  class: "button-link" %>
            <%= link_to "Remove", system_management_path(tab: "employees", confirm_remove_user_id: user.id),
                  class: "btn-delete" %>
          <% end %>
        </div>
      <% end %>
    </li>
  <% end %>
</ul>

<% unless params[:edit_user_id].present? %>
  <details class="mt-2">
    <summary class="button-link cursor-pointer select-none">Add Employee</summary>
    <div class="mt-3">
      <%= form_with url: users_path, local: true do |f| %>
        <div class="grid gap-3 max-w-md">
          <div class="form-row">
            <%= f.label :first_name, "First Name", class: "font-semibold text-gray-800" %>
            <%= f.text_field :first_name, placeholder: "First Name", class: "input-large" %>
          </div>
          <div class="form-row">
            <%= f.label :last_name, "Last Name", class: "font-semibold text-gray-800" %>
            <%= f.text_field :last_name, placeholder: "Last Name", class: "input-large" %>
          </div>
          <div class="form-row">
            <%= f.label :email, "Email", class: "font-semibold text-gray-800" %>
            <%= f.email_field :email, placeholder: "Email", class: "input-large" %>
          </div>
          <div class="form-row">
            <%= f.label :role, "Role", class: "font-semibold text-gray-800" %>
            <%= f.select :role, User.roles.keys.map { |r| [ r.humanize, r ] }, {},
                  class: "input-large" %>
          </div>
          <%= f.submit "Save Employee", class: "button-primary mt-1" %>
        </div>
      <% end %>
    </div>
  </details>
<% end %>
