<div class="volunteer-page">

  <% if @recent_syncs.any? %>
    <div class="alert-success" id="sync-notifications">
      <p class="font-semibold mb-1">Recent Transfers</p>
      <ul class="list-disc list-inside text-sm">
        <% @recent_syncs.each do |log| %>
          <li><%= log.volunteer.full_name %> data was transferred to the external system</li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <h1 class="page-title">System Management</h1>

  <div class="card">
    <nav class="sys-tabs" aria-label="System item sections">
      <%= system_management_tab_link("Reminder Frequencies", "frequencies", @tab) %>
      <%= system_management_tab_link("Volunteer Tags", "tags", @tab) %>
      <%= system_management_tab_link("Employees", "employees", @tab) %>
      <%= system_management_tab_link("Referral Sources", "referral_sources", @tab) %>
    </nav>

    <% case @tab %>
    <% when "tags" %>
      <%= render "system_management/tags" %>
    <% when "employees" %>
      <%= render "system_management/employees" %>
    <% when "referral_sources" %>
      <%= render "system_management/referral_sources" %>
    <% else %>
      <%= render "system_management/frequencies" %>
    <% end %>
  </div>

  <div class="card">
    <h2 class="section-heading">Import Historical Data</h2>
    <p class="help-text">Upload a CSV or spreadsheet to import historical volunteer records.</p>

    <%= form_with url: import_system_management_path, multipart: true do |f| %>
      <div class="inline-form items-center">
        <%= f.file_field :file, id: "import_file",
              class: "sr-only",
              accept: ".csv,.xlsx,.xls",
              onchange: "
                document.getElementById('import-filename').textContent = this.files[0]?.name ?? '';
                document.getElementById('import-submit').classList.toggle('hidden', !this.files.length);
              " %>
        <label for="import_file" class="button-link cursor-pointer">
          Choose File
        </label>
        <span id="import-filename" class="text-sm text-gray-600 truncate max-w-xs"></span>
        <%= f.submit "Import Data", id: "import-submit",
              class: "button-primary hidden" %>
      </div>
    <% end %>
  </div>

  <div class="card" id="export-data-section">
    <h2 class="section-heading">Export Data</h2>
    <%= form_with url: export_data_system_management_path, method: :post, local: true, data: { turbo: false } do |f| %>
      <div class="grid gap-3 max-w-md">
        <div class="form-row">
          <%= label_tag "Title", "Title", class: "font-semibold text-gray-800" %>
          <%= text_field_tag "Title", nil, class: "input-large" %>
        </div>

        <div class="form-row">
          <%= label_tag "export format", "Export Format", class: "font-semibold text-gray-800" %>
          <%= select_tag "export format", options_for_select(["Excel"]), include_blank: "Select...", class: "input-large" %>
        </div>

        <div class="form-row">
          <%= label_tag "Status", "Status", class: "font-semibold text-gray-800" %>
          <%= select_tag "Status", options_for_select([
            "Attended an Information Session",
            "Inquiry",
            "Application Sent",
            "Applied",
            "Inactive"
          ]), include_blank: "All Statuses", class: "input-large" %>
        </div>

        <div class="form-row">
          <%= label_tag "Start Date", "Start Date", class: "font-semibold text-gray-800" %>
          <%= text_field_tag "Start Date", nil, placeholder: "MM/DD/YYYY", class: "input-large" %>
        </div>

        <div class="form-row">
          <%= label_tag "End Date", "End Date", class: "font-semibold text-gray-800" %>
          <%= text_field_tag "End Date", nil, placeholder: "MM/DD/YYYY", class: "input-large" %>
        </div>

        <div class="mt-1">
          <%= submit_tag "Export Data", name: "commit", class: "button-primary" %>
        </div>
      </div>
    <% end %>
  </div>

</div>
