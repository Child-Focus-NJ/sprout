<main class="volunteer-page">
  <nav class="page-nav page-nav--back" aria-label="Back">
    <%= back_nav_link volunteer_path(@volunteer), "Back to profile" %>
  </nav>
  <h1 class="page-title">Send Email</h1>

  <section class="card email-compose-card" id="email-compose">
    <h2 class="subsection-heading">Your email</h2>
    <p class="subtle">To <%= @volunteer.full_name %> · <%= @volunteer.email %></p>
    <%= form_with url: send_email_volunteer_path(@volunteer), method: :post, html: { class: "email-compose" } do %>
      <div class="email-compose__field">
        <%= label_tag :subject, "Subject" %>
        <%= text_field_tag :subject, @subject, required: true, maxlength: Email::MailchimpOutbound::MAX_SUBJECT_LENGTH, class: "input-large" %>
      </div>
      <div class="email-compose__field">
        <%= label_tag :message, "Message" %>
        <%= text_area_tag :message, @message, required: true, class: "email-compose__body", placeholder: "Write the email" %>
      </div>
      <div>
        <button type="submit" class="button-primary">Send</button>
      </div>
    <% end %>
  </section>

  <% if @volunteer.communications.email.exists? %>
    <section class="card" id="email-history">
      <h2 class="subsection-heading">Previous emails</h2>
      <% @volunteer.communications.email.recent.each do |comm| %>
        <div class="communication-entry">
          <strong><%= comm.subject %></strong>
          <span class="delivery-status"><%= comm.status %></span>
          <% time = comm.sent_at || comm.created_at %>
          <time datetime="<%= time.iso8601 %>"><%= time.strftime("%Y-%m-%d %H:%M") %></time>
          <%= render "collapsible_message", text: comm.body, error_message: comm.error_message, id: "comm-body-#{comm.id}" %>
        </div>
      <% end %>
    </section>
  <% end %>
</main>
