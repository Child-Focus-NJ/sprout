<main class="volunteer-page">
<h1 class="page-title">Volunteers</h1>

<%# Status tabs on the left and the name search on the right, sitting on top of the list like folder tabs %>
<div class="volunteer-tabs-bar">
  <nav class="volunteer-status-tabs" id="volunteer-status-tabs" aria-label="Filter volunteers by status">
    <%= volunteer_status_tab("All", nil, @status_counts.values.sum, active: @filters[:status].nil?, query: @filters[:q]) %>
    <% volunteer_status_options.each do |label, stage| %>
      <%= volunteer_status_tab(label, stage, @status_counts.fetch(stage, 0), active: @filters[:status] == stage, query: @filters[:q]) %>
    <% end %>
  </nav>

  <%= form_with url: volunteers_path, method: :get, local: true,
                html: { class: "volunteer-search", role: "search", aria: { label: "Search volunteers" } } do %>
    <%# Searching keeps you on the current status tab %>
    <%= hidden_field_tag :status, @filters[:status], id: nil if @filters[:status] %>
    <div class="volunteer-search__field">
      <svg class="volunteer-search__icon" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
        <path stroke-linecap="round" stroke-linejoin="round" d="m21 21-5.197-5.197m0 0A7.5 7.5 0 1 0 5.196 5.196a7.5 7.5 0 0 0 10.607 10.607Z" />
      </svg>
      <label for="q" class="sr-only">Search by name</label>
      <%= search_field_tag :q, @filters[:q], placeholder: "Search by name", class: "input-large", autocomplete: "off" %>
    </div>
  <% end %>
</div>

<%# Row checkboxes post straight to Send Application; Add Note and Send SMS copy the selection into the popup. %>
<%= form_with url: bulk_send_application_volunteers_path, method: :post, html: { class: "card note-form volunteer-list-card", id: "volunteer-bulk-form" } do %>
  <% @filters.each do |key, value| %>
    <%= hidden_field_tag key, value, id: nil %>
  <% end %>
  <%= hidden_field_tag :return_to, request.fullpath, id: nil %>

  <% if @volunteers.any? %>
    <div class="volunteer-select-all">
      <label>
        <input type="checkbox" id="select-all-volunteers" data-bulk-select-all>
        Select all <%= @volunteers.size %>
      </label>
    </div>
  <% end %>

  <section id="volunteer-list" class="volunteer-list">
    <% @volunteers.each do |volunteer| %>
      <div class="volunteer-row">
        <input type="checkbox" id="volunteer_<%= volunteer.id %>" name="volunteer_ids[]" value="<%= volunteer.id %>"
               data-bulk-select data-has-phone="<%= volunteer.phone.present? %>">
        <div class="volunteer-meta">
          <label for="volunteer_<%= volunteer.id %>" class="volunteer-name"><%= volunteer.full_name %></label>
          <div class="volunteer-subtext">
            <span>Contact: <%= volunteer.phone.presence || volunteer.email %></span>
            <% if volunteer.nj_county %>
              <span><%= volunteer.nj_county_name %> County</span>
            <% end %>
            <%= volunteer_status_badge(volunteer) %>
          </div>
        </div>
        <div class="volunteer-actions">
          <%= link_to "View profile", volunteer_path(volunteer), class: "button-link profile-link" %>
          <%= message_dialog_button(volunteer, :note) %>
          <%= message_dialog_button(volunteer, :sms) %>
        </div>
      </div>
    <% end %>

    <% if @volunteers.empty? %>
      <p class="volunteer-list-empty">
        <% if @filters[:q] %>
          No volunteers match your search. <%= link_to "Clear search", volunteers_path(@filters.except(:q)) %>
        <% elsif @filters[:status] %>
          No volunteers are at <%= VolunteersHelper::STATUS_BADGE_LABELS.fetch(@filters[:status]) %> right now.
        <% else %>
          No volunteers yet.
        <% end %>
      </p>
    <% end %>
  </section>

  <%# Sticks to the bottom of the screen while scrolling, and only shows once something is selected %>
  <div id="bulk-toolbar" class="bulk-toolbar" role="region" aria-label="Bulk actions" data-bulk-toolbar hidden>
    <span class="bulk-toolbar__count"><strong data-bulk-count>0</strong> selected</span>
    <div class="bulk-toolbar__actions">
      <%= bulk_message_button(:note) %>
      <%= bulk_message_button(:sms) %>
      <button type="submit" class="button-link bulk-toolbar__button">Send Application</button>
      <button type="button" class="bulk-toolbar__clear" data-bulk-clear>Clear</button>
    </div>
  </div>
<% end %>

<%= render "message_dialog" %>

<script>
  (function () {
    const toolbar = document.querySelector("[data-bulk-toolbar]");
    const selectAll = document.querySelector("[data-bulk-select-all]");
    if (!toolbar || !selectAll) return;

    const boxes = [...document.querySelectorAll("[data-bulk-select]")];
    const count = toolbar.querySelector("[data-bulk-count]");
    const checkedCount = () => boxes.filter((box) => box.checked).length;

    // Show the toolbar only while something is selected, and keep Select all in step with the rows
    function refresh() {
      const checked = checkedCount();
      count.textContent = checked;
      toolbar.hidden = checked === 0;
      selectAll.checked = checked === boxes.length;
      selectAll.indeterminate = checked > 0 && checked < boxes.length;
    }

    function selectEvery(checked) {
      boxes.forEach((box) => { box.checked = checked; });
      refresh();
    }

    boxes.forEach((box) => box.addEventListener("change", refresh));
    selectAll.addEventListener("change", () => selectEvery(selectAll.checked));
    toolbar.querySelector("[data-bulk-clear]").addEventListener("click", () => selectEvery(false));

    // Sending the application moves people to "Application sent", so double-check first
    document.getElementById("volunteer-bulk-form").addEventListener("submit", (event) => {
      const checked = checkedCount();
      if (!confirm(`Send the application to ${checked} selected volunteer${checked === 1 ? "" : "s"}?`)) {
        event.preventDefault();
      }
    });

    // The browser can restore ticked boxes on Back, so sync the toolbar on every page show
    window.addEventListener("pageshow", refresh);
    refresh();
  })();
</script>
</main>
