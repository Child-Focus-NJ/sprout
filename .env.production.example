# Production deployment template. Set these in the hosting platform's secret store.
# The production Docker image excludes .env files; inject values at runtime.
# Supply the production account's credentials to both the web and job processes.
RAILS_ENV=production
DATABASE_URL=
SECRET_KEY_BASE=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# PRODUCTION Mandrill account credentials; never copy the local testing key here.
MANDRILL_API_KEY=
MANDRILL_SMS_FROM=
MANDRILL_FROM_EMAIL=
SPROUT_SMS_MAILCHIMP_ENABLED=false
SPROUT_EMAIL_MAILCHIMP_ENABLED=false

# Set the channel flags to true when production credentials/senders are configured.
# Keep any existing Rails master key, AWS, storage, VMS and deployment settings.
# If jobs run inside Puma (otherwise configure a separate worker/scheduler):
SOLID_QUEUE_IN_PUMA=true
